{
  "name": "Rocket suite",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [3100, 3300, 3200, 3000, 8025],
  "portsAttributes": {
    "3100": { "label": "Rocket Auth", "onAutoForward": "notify" },
    "3300": { "label": "Rocket Print", "onAutoForward": "silent" },
    "3200": { "label": "Rocket Cloud", "onAutoForward": "silent" },
    "3000": { "label": "Rocket Mailer", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit", "onAutoForward": "silent" },
    "5432": { "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash .devcontainer/clone-bricks.sh",
  "postStartCommand": "bash .devcontainer/start.sh"
}
